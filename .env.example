# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Optional: token for authenticated engine API calls (leave blank for local stdio use)
EMPTYSOCK_API_TOKEN=

# Optional: restrict SSE transport to this bearer token
MCP_AUTH_TOKEN=

# Directory that the save-system tools may read/write (must be absolute)
# Defaults to the process cwd if unset — set explicitly in production.
SAVE_BASE_DIR=
