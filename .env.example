# emptysock-mcp environment variables
# Copy this file to .env and fill in values as needed.
# Never commit .env — it is gitignored.
#
# The server does not load .env by itself. Run it with:
#   node --env-file=.env dist/server.js        (Node 20.6+)
#   npx tsx --env-file=.env src/server.ts      (development)
# or export these variables / set them in your MCP host's `env` block.

# Absolute path that save-system tools (save_read, save_write, save_delete,
# save_list) are allowed to access.
# Defaults to the process working directory if unset.
# Set this explicitly in production to a dedicated, writable directory.
SAVE_BASE_DIR=/absolute/path/to/your/saves

# Absolute path where project asset files live. story_graph_export reads
# .storyGraph.json files from {ASSET_BASE_DIR}/{sceneId}/{graphId}.storyGraph.json.
# Defaults to the process working directory if unset.
# Set this to your game project's assets directory in production.
ASSET_BASE_DIR=/absolute/path/to/your/assets

# Rate limiter: maximum tool calls per tool name per window.
# Default: 60
RATE_LIMIT_MAX=60

# Rate limiter: sliding window duration in milliseconds.
# Default: 60000 (1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Port the live-bridge WebSocket server listens on (127.0.0.1 only). A live
# game/IDE preview dials in as the client so physics_*/scene_*/navmesh_*/
# actor_* tools can relay real EngineQuery/EngineQueryResult calls to it
# instead of returning fabricated placeholder data.
# Default: 7777
EMPTYSOCK_BRIDGE_PORT=7777
